# processor (preprocess data to match the model)
train_ds = tf.keras.utils.image_dataset_from_directory('./rotten-fruits/dataset/train')
test_ds = tf.keras.utils.image_dataset_from_directory('./rotten-fruits/dataset/test')

# reshape data
train_ds = train_ds.map(lambda x, y: (tf.image.resize(x, (224, 224)), y))
test_ds = test_ds.map(lambda x, y: (tf.image.resize(x, (224, 224)), y))

# normailze image values
train_ds = train_ds.map(lambda x, y: (x/255.0, y))
test_ds = test_ds.map(lambda x, y: (x/255.0, y))

